columns: 1fr auto;\r\n  cursor: default;\r\n}\r\n\r\n.hl2-chapter--custom:hover {\r\n  transform: none;\r\n}\r\n\r\n.hl2-chapter__tag {\r\n  margin-left: 8px;\r\n  padding: 1px 6px;\r\n  font-size: 9px;\r\n  letter-spacing: 0.14em;\r\n  color: var(--hl2-muted);\r\n  border: 1px solid rgba(255, 138, 26, 0.35);\r\n  vertical-align: middle;\r\n}\r\n\r\n.hl2-chapter__buttons {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n\r\n.hl2-chapter--empty {\r\n  cursor: default;\r\n  border-color: transparent;\r\n  background: transparent;\r\n  color: var(--hl2-muted);\r\n  font-style: italic;\r\n}\r\n\r\n.hl2-chapter--empty:hover {\r\n  background: transparent;\r\n  transform: none;\r\n}\r\n\r\n/* ------------------------------------------------------------------- Tabs */\r\n\r\n.hl2-tabs {\r\n  display: flex;\r\n  gap: 2px;\r\n  margin-bottom: 18px;\r\n  border-bottom: 1px solid var(--hl2-line);\r\n}\r\n\r\n.hl2-tab {\r\n  padding: 8px 14px;\r\n  background: transparent;\r\n  border: 0;\r\n  color: var(--hl2-muted);\r\n  cursor: pointer;\r\n  font-family: inherit;\r\n  font-size: 11px;\r\n  letter-spacing: 0.18em;\r\n  text-transform: uppercase;\r\n  border-bottom: 2px solid transparent;\r\n  margin-bottom: -1px;\r\n  transition:\r\n    color 140ms ease,\r\n    border-color 140ms ease;\r\n}\r\n\r\n.hl2-tab:hover,\r\n.hl2-tab:focus-visible {\r\n  color: var(--hl2-yellow);\r\n  outline: none;\r\n}\r\n\r\n.hl2-tab.is-active {\r\n  color: var(--hl2-orange);\r\n  border-bottom-color: var(--hl2-orange);\r\n}\r\n\r\n/* --------------------------------------------------------------- Workshop */\r\n\r\n/* Panel ancho (estilo Steam): cabecera/footer fijos, cuerpo con scroll propio. */\r\n.hl2-panel--wide {\r\n  width: min(1060px, 95vw);\r\n  max-height: min(84vh, 860px);\r\n  padding: 0;\r\n  overflow: hidden;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.hl2-workshop__top {\r\n  padding: clamp(20px, 2.4vw, 28px) clamp(22px, 2.6vw, 32px) 0;\r\n}\r\n\r\n.hl2-workshop__toolbar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 16px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hl2-workshop__toolbar .hl2-tabs {\r\n  margin-bottom: 0;\r\n  border-bottom: 0;\r\n}\r\n\r\n.hl2-workshop__search {\r\n  flex: 0 1 280px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 7px 12px;\r\n  background: rgba(0, 0, 0, 0.45);\r\n  border: 1px solid var(--hl2-line);\r\n  border-bottom-width: 2px;\r\n}\r\n\r\n.hl2-workshop__search::before {\r\n  content: \"\\2315\";\r\n  color: var(--hl2-orange);\r\n  font-size: 15px;\r\n}\r\n\r\n.hl2-workshop__search input {\r\n  flex: 1;\r\n  border: 0;\r\n  background: transparent;\r\n  color: var(--hl2-text);\r\n  font-family: inherit;\r\n  font-size: 12px;\r\n  letter-spacing: 0.04em;\r\n}\r\n\r\n.hl2-workshop__search input:focus {\r\n  outline: none;\r\n}\r\n\r\n.hl2-workshop__body {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  padding: 18px clamp(22px, 2.6vw, 32px) 10px;\r\n  scrollbar-width: thin;\r\n  scrollbar-color: var(--hl2-orange-soft) rgba(0, 0, 0, 0.45);\r\n}\r\n\r\n.hl2-workshop__foot {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 14px;\r\n  padding: 10px clamp(22px, 2.6vw, 32px);\r\n  border-top: 1px solid var(--hl2-line);\r\n  background: rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n.hl2-workshop__foot .hl2-status,\r\n.hl2-workshop__foot .hl2-actions {\r\n  margin: 0;\r\n}\r\n\r\n.hl2-workshop__account {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n  margin: 0 0 16px;\r\n  padding: 12px 14px;\r\n  background: rgba(10, 8, 4, 0.5);\r\n  border-left: 2px solid rgba(255, 138, 26, 0.3);\r\n  font-size: 12px;\r\n  letter-spacing: 0.04em;\r\n  color: var(--hl2-text);\r\n}\r\n\r\n.hl2-workshop__account .hl2-button {\r\n  margin-left: auto;\r\n}\r\n\r\n.hl2-workshop__empty {\r\n  display: grid;\r\n  place-items: center;\r\n  text-align: center;\r\n  min-height: 200px;\r\n  padding: 24px;\r\n  color: var(--hl2-muted);\r\n  font-style: italic;\r\n  letter-spacing: 0.04em;\r\n}\r\n\r\n/* --- Grid de tarjetas --- */\r\n\r\n.hl2-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(232px, 1fr));\r\n  gap: 14px;\r\n  margin: 0;\r\n  padding: 0;\r\n  list-style: none;\r\n}\r\n\r\n.hl2-card {\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: linear-gradient(180deg, rgba(18, 16, 13, 0.7), rgba(8, 8, 9, 0.78));\r\n  border: 1px solid rgba(255, 138, 26, 0.18);\r\n  transition:\r\n    border-color 160ms ease,\r\n    transform 160ms var(--hl2-ease),\r\n    box-shadow 160ms ease;\r\n}\r\n\r\n.hl2-card:hover {\r\n  border-color: var(--hl2-orange);\r\n  transform: translateY(-3px);\r\n  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);\r\n}\r\n\r\n.hl2-card__banner,\r\n.hl2-detail__banner {\r\n  position: relative;\r\n  display: grid;\r\n  place-items: center;\r\n  overflow: hidden;\r\n  background: linear-gradient(\r\n    135deg,\r\n    hsl(var(--h, 28) 38% 20%),\r\n    hsl(calc(var(--h, 28) + 36) 44% 9%)\r\n  );\r\n}\r\n\r\n.hl2-card__banner {\r\n  height: 112px;\r\n}\r\n\r\n.hl2-card__banner::after,\r\n.hl2-detail__banner::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  background:\r\n    repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0 2px, transparent 2px 9px),\r\n    radial-gradient(ellipse at 50% 120%, rgba(0, 0, 0, 0.5), transparent 70%);\r\n}\r\n\r\n.hl2-card__glyph {\r\n  position: relative;\r\n  z-index: 1;\r\n  font-family: \"Georgia\", \"Times New Roman\", serif;\r\n  font-size: 46px;\r\n  color: rgba(255, 226, 180, 0.85);\r\n  text-shadow: 0 0 18px rgba(0, 0, 0, 0.5);\r\n}\r\n\r\n.hl2-card__badge {\r\n  position: absolute;\r\n  top: 8px;\r\n  right: 8px;\r\n  z-index: 1;\r\n  padding: 2px 8px;\r\n  font-size: 9px;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  color: var(--hl2-text);\r\n  background: rgba(0, 0, 0, 0.62);\r\n  border: 1px solid var(--hl2-line);\r\n}\r\n\r\n.hl2-card__badge.is-on {\r\n  color: #46d17a;\r\n  border-color: rgba(70, 209, 122, 0.5);\r\n}\r\n\r\n.hl2-card__main {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 12px 14px 8px;\r\n}\r\n\r\n.hl2-card__title {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  letter-spacing: 0.04em;\r\n  color: var(--hl2-yellow);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.hl2-card__author {\r\n  font-size: 11px;\r\n  letter-spacing: 0.04em;\r\n  color: var(--hl2-muted);\r\n}\r\n\r\n.hl2-card__stats {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  margin-top: 2px;\r\n  font-size: 11px;\r\n  color: var(--hl2-muted);\r\n}\r\n\r\n.hl2-card__actions {\r\n  display: flex;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n  padding: 8px 14px 12px;\r\n}\r\n\r\n.hl2-card__actions .hl2-button {\r\n  font-size: 12px;\r\n}\r\n\r\n/* --- Star widget (tamaños) --- */\r\n\r\n.hl2-stars {\r\n  display: inline-flex;\r\n  gap: 3px;\r\n}\r\n\r\n.hl2-stars--readonly {\r\n  pointer-events: none;\r\n}\r\n\r\n.hl2-star {\r\n  width: 24px;\r\n  height: 24px;\r\n  padding: 0;\r\n  border: 0;\r\n  background: transparent;\r\n  color: rgba(231, 227, 216, 0.28);\r\n  font-size: 21px;\r\n  line-height: 1;\r\n  cursor: pointer;\r\n  font-family: inherit;\r\n  transition:\r\n    color 120ms ease,\r\n    transform 120ms var(--hl2-ease);\r\n}\r\n\r\n.hl2-star.is-filled {\r\n  color: var(--hl2-orange);\r\n  text-shadow: 0 0 8px rgba(255, 138, 26, 0.5);\r\n}\r\n\r\n.hl2-stars:not(.hl2-stars--readonly) .hl2-star:hover {\r\n  transform: scale(1.18);\r\n}\r\n\r\n.hl2-stars--sm {\r\n  gap: 1px;\r\n}\r\n\r\n.hl2-stars--sm .hl2-star {\r\n  width: 14px;\r\n  height: 14px;\r\n  font-size: 13px;\r\n}\r\n\r\n.hl2-stars--lg {\r\n  gap: 6px;\r\n}\r\n\r\n.hl2-stars--lg .hl2-star {\r\n  width: 34px;\r\n  height: 34px;\r\n  font-size: 32px;\r\n}\r\n\r\n.hl2-stars__summary {\r\n  font-size: 12px;\r\n  letter-spacing: 0.06em;\r\n  color: var(--hl2-muted);\r\n}\r\n\r\n/* --- Detalle (hero + secciones) --- */\r\n\r\n.hl2-detail {\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n\r\n.hl2-detail__back {\r\n  margin: 0;\r\n}\r\n\r\n.hl2-detail__hero {\r\n  display: grid;\r\n  grid-template-columns: 210px 1fr;\r\n  gap: 20px;\r\n  align-items: stretch;\r\n}\r\n\r\n.hl2-detail__banner {\r\n  min-height: 158px;\r\n  border: 1px solid rgba(255, 138, 26, 0.2);\r\n}\r\n\r\n.hl2-detail__banner .hl2-card__glyph {\r\n  font-size: 72px;\r\n}\r\n\r\n.hl2-detail__headline {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.hl2-detail__headline h2 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n  letter-spacing: 0.04em;\r\n  color: var(--hl2-yellow);\r\n}\r\n\r\n.hl2-detail__author {\r\n  font-size: 12px;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  color: var(--hl2-muted);\r\n}\r\n\r\n.hl2-detail__statline {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 8px 18px;\r\n  font-size: 12px;\r\n  letter-spacing: 0.04em;\r\n  color: var(--hl2-muted);\r\n}\r\n\r\n.hl2-detail__statline strong {\r\n  color: var(--hl2-text);\r\n  font-weight: 600;\r\n}\r\n\r\n.hl2-detail__hero-actions {\r\n  display: flex;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n  margin-top: auto;\r\n  padding-top: 6px;\r\n}\r\n\r\n.hl2-detail__desc {\r\n  margin: 0;\r\n  font-size: 13px;\r\n  line-height: 1.6;\r\n  color: var(--hl2-text);\r\n}\r\n\r\n.hl2-detail__section {\r\n  padding-top: 16px;\r\n  border-top: 1px solid rgba(255, 138, 26, 0.18);\r\n}\r\n\r\n.hl2-detail__section > h3 {\r\n  margin: 0 0 12px;\r\n  font-size: 11px;\r\n  letter-spacing: 0.22em;\r\n  text-transform: uppercase;\r\n  color: var(--hl2-orange);\r\n}\r\n\r\n.hl2-rate {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 18px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.hl2-rate__big {\r\n  font-size: 40px;\r\n  line-height: 1;\r\n  font-weight: 700;\r\n  color: var(--hl2-yell