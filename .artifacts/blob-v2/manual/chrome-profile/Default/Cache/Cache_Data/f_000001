const __vite__css = ":root {\r\n  font-family:\r\n    Inter,\r\n    ui-sans-serif,\r\n    system-ui,\r\n    -apple-system,\r\n    BlinkMacSystemFont,\r\n    \"Segoe UI\",\r\n    sans-serif;\r\n  color: #edf4ff;\r\n  background: #05070b;\r\n  font-synthesis: none;\r\n  text-rendering: optimizeLegibility;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n}\r\n\r\n* {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml,\r\nbody,\r\n#app {\r\n  width: 100%;\r\n  height: 100%;\r\n  margin: 0;\r\n  overflow: hidden;\r\n}\r\n\r\nbody {\r\n  background: #05070b;\r\n}\r\n\r\n.is-hidden {\r\n  opacity: 0;\r\n  pointer-events: none;\r\n}\r\n\r\n.game-root {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.game-canvas {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n/* ============================================================\r\n * HUD wrapper + paleta HL2\r\n * ============================================================ */\r\n\r\n.hud {\r\n  position: absolute;\r\n  inset: 0;\r\n  pointer-events: none;\r\n}\r\n\r\n/* Modo muerte: el HUD sigue visible pero solo los vitales (salud/traje), por\r\n   encima del oscurecido del DeathScreen (de ahi el z-index). Reusa el HUD real\r\n   en vez de dibujar vitales aparte. */\r\n.hud.is-death {\r\n  z-index: 55;\r\n}\r\n\r\n.hud.is-death > :not(.hl-vitals) {\r\n  display: none;\r\n}\r\n\r\n.hud.is-death .hl-aux {\r\n  display: none;\r\n}\r\n\r\n.hev-hud {\r\n  --hl-amber: rgba(220, 185, 0, 0.95);\r\n  --hl-amber-strong: rgba(220, 185, 0, 1);\r\n  --hl-amber-dim: rgba(220, 185, 0, 0.65);\r\n  --hl-amber-faint: rgba(220, 185, 0, 0.28);\r\n  --hl-glow: 0 0 6px rgba(220, 185, 0, 0.45);\r\n  --hl-glow-soft: 0 0 4px rgba(220, 185, 0, 0.35);\r\n  --hl-red: #ff3e27;\r\n  color: var(--hl-amber);\r\n  font-family:\r\n    \"Bahnschrift Condensed\", \"Arial Narrow\", \"Roboto Condensed\", \"Tahoma\",\r\n    \"Segoe UI\", sans-serif;\r\n  font-stretch: condensed;\r\n  letter-spacing: 0.02em;\r\n}\r\n\r\n/* ============================================================\r\n * Vitals (bottom-left): salud + traje + AUX. POWER\r\n * ============================================================ */\r\n\r\n.hl-vitals {\r\n  position: absolute;\r\n  left: 35px;\r\n  bottom: 35px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 14px;\r\n}\r\n\r\n.hl-vitals__main {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  gap: 44px;\r\n}\r\n\r\n.hl-vital {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 18px;\r\n}\r\n\r\n.hl-vital__pictogram {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 6px;\r\n  width: 44px;\r\n}\r\n\r\n.hl-vital__icon {\r\n  width: 38px;\r\n  height: 38px;\r\n  color: var(--hl-amber);\r\n  filter: drop-shadow(var(--hl-glow-soft));\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.hl-vital__icon svg {\r\n  width: 100%;\r\n  height: 100%;\r\n  display: block;\r\n}\r\n\r\n.hl-vital__label {\r\n  font-size: 12px;\r\n  letter-spacing: 0.22em;\r\n  color: var(--hl-amber-dim);\r\n  text-transform: uppercase;\r\n  line-height: 1;\r\n}\r\n\r\n.hl-vital__value {\r\n  font-size: 62px;\r\n  font-weight: 300;\r\n  line-height: 0.82;\r\n  color: var(--hl-amber);\r\n  text-shadow: var(--hl-glow);\r\n  letter-spacing: -0.02em;\r\n  min-width: 1.6ch;\r\n  text-align: left;\r\n}\r\n\r\n.hl-vital.is-disabled .hl-vital__value,\r\n.hl-vital.is-disabled .hl-vital__icon,\r\n.hl-vital.is-disabled .hl-vital__label {\r\n  opacity: 0.4;\r\n}\r\n\r\n.hl-vitals.is-critical .hl-vital--health .hl-vital__value,\r\n.hl-vitals.is-critical .hl-vital--health .hl-vital__icon {\r\n  color: var(--hl-red);\r\n  text-shadow: 0 0 8px rgb(255 62 39 / 0.6);\r\n  animation: hl-critical 0.8s ease-in-out infinite alternate;\r\n}\r\n\r\n/* AUX. POWER — barra segmentada HL2. Se autoesconde cuando está al 100%\r\n * (fade-out lento) y reaparece apenas baja (fade-in rápido). */\r\n\r\n.hl-aux {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 5px;\r\n  padding-left: 2px;\r\n  opacity: 0;\r\n  transition: opacity 600ms ease;\r\n}\r\n\r\n.hl-aux.is-active {\r\n  opacity: 1;\r\n  transition: opacity 80ms ease;\r\n}\r\n\r\n.hl-aux__label {\r\n  font-size: 11px;\r\n  letter-spacing: 0.3em;\r\n  color: var(--hl-amber-dim);\r\n  text-transform: uppercase;\r\n  line-height: 1;\r\n}\r\n\r\n.hl-aux__bar {\r\n  display: flex;\r\n  gap: 3px;\r\n}\r\n\r\n.hl-aux__seg {\r\n  width: 16px;\r\n  height: 7px;\r\n  background: rgba(220, 185, 0, 0.07);\r\n  border: 1px solid rgba(220, 185, 0, 0.32);\r\n  transition: background-color 80ms linear, box-shadow 80ms linear,\r\n    border-color 80ms linear;\r\n}\r\n\r\n.hl-aux__seg.is-on {\r\n  background: var(--hl-amber-strong);\r\n  box-shadow: 0 0 5px rgba(220, 185, 0, 0.55);\r\n}\r\n\r\n.hl-aux.is-low .hl-aux__label,\r\n.hl-aux.is-low .hl-aux__seg.is-on {\r\n  animation: hl-critical 1.2s ease-in-out infinite alternate;\r\n}\r\n\r\n.hl-aux.is-depleted .hl-aux__label {\r\n  color: var(--hl-red);\r\n  animation: hl-critical 0.55s ease-in-out infinite alternate;\r\n}\r\n\r\n.hl-aux.is-depleted .hl-aux__seg {\r\n  border-color: rgba(255, 62, 39, 0.4);\r\n}\r\n\r\n@keyframes hl-critical {\r\n  from {\r\n    opacity: 0.75;\r\n  }\r\n  to {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n/* ============================================================\r\n * Ammo (bottom-right)\r\n * ============================================================ */\r\n\r\n.hl-ammo {\r\n  position: absolute;\r\n  right: 35px;\r\n  bottom: 35px;\r\n  text-align: right;\r\n  font-family: inherit;\r\n}\r\n\r\n.hl-ammo__label {\r\n  font-size: 12px;\r\n  letter-spacing: 0.22em;\r\n  color: var(--hl-amber-dim);\r\n  text-transform: uppercase;\r\n  margin-bottom: 4px;\r\n  line-height: 1;\r\n}\r\n\r\n.hl-ammo__row {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: flex-end;\r\n  gap: 32px;\r\n}\r\n\r\n.hl-ammo__secondary {\r\n  display: none;\r\n  margin-bottom: 5px;\r\n  font-size: 34px;\r\n  font-weight: 300;\r\n  line-height: 0.9;\r\n  color: var(--hl-amber);\r\n  text-shadow: var(--hl-glow-soft);\r\n  letter-spacing: 0;\r\n}\r\n\r\n.hl-ammo.has-secondary .hl-ammo__secondary {\r\n  display: block;\r\n}\r\n\r\n.hl-ammo.is-secondary-empty .hl-ammo__secondary {\r\n  color: var(--hl-red);\r\n  text-shadow: 0 0 8px rgb(255 62 39 / 0.6);\r\n}\r\n\r\n.hl-ammo__current {\r\n  font-size: 68px;\r\n  font-weight: 300;\r\n  line-height: 0.82;\r\n  color: var(--hl-amber);\r\n  text-shadow: var(--hl-glow);\r\n  letter-spacing: -0.02em;\r\n  min-width: 1.6ch;\r\n  text-align: right;\r\n}\r\n\r\n.hl-ammo__reserve {\r\n  font-size: 30px;\r\n  font-weight: 300;\r\n  line-height: 1;\r\n  color: var(--hl-amber-dim);\r\n  letter-spacing: -0.01em;\r\n}\r\n\r\n.hl-ammo.is-low .hl-ammo__current,\r\n.hl-ammo.is-empty .hl-ammo__current {\r\n  color: var(--hl-red);\r\n  text-shadow: 0 0 8px rgb(255 62 39 / 0.6);\r\n}\r\n\r\n.hl-ammo.is-firing .hl-ammo__current {\r\n  transform: translateX(-1px);\r\n}\r\n\r\n/* ============================================================\r\n * Weapon selector (top-center)\r\n *\r\n * Layout: fila de columnas (una por slot). El slot activo despliega\r\n * verticalmente sus armas con la tentativa highlighteada, y el nombre\r\n * abajo dentro de la misma columna, así el bloque queda anclado bajo\r\n * el número del slot activo (no centrado en toda la fila).\r\n * ============================================================ */\r\n\r\n.hl-selector {\r\n  position: absolute;\r\n  top: 44px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 38px;\r\n  opacity: 0;\r\n  pointer-events: none;\r\n  transition: opacity 110ms ease-out;\r\n  font-family: inherit;\r\n}\r\n\r\n.hl-selector.is-visible {\r\n  opacity: 1;\r\n}\r\n\r\n.hl-selector__column {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-width: 110px;\r\n}\r\n\r\n.hl-selector__num {\r\n  font-size: 26px;\r\n  font-weight: 300;\r\n  line-height: 1;\r\n  color: var(--hl-amber-dim);\r\n  letter-spacing: 0;\r\n  min-width: 1ch;\r\n  text-align: center;\r\n  transition:\r\n    color 80ms linear,\r\n    text-shadow 80ms linear;\r\n}\r\n\r\n.hl-selector__num.is-empty {\r\n  color: var(--hl-amber-faint);\r\n}\r\n\r\n.hl-selector__num.is-active {\r\n  color: var(--hl-amber-strong);\r\n  text-shadow: var(--hl-glow);\r\n  font-size: 30px;\r\n}\r\n\r\n.hl-selector__list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: stretch;\r\n  gap: 6px;\r\n  width: 110px;\r\n  margin-top: 4px;\r\n}\r\n\r\n.hl-selector__item {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  height: 52px;\r\n  padding: 6px 10px;\r\n  color: var(--hl-amber-dim);\r\n  opacity: 0.5;\r\n  transition:\r\n    opacity 80ms linear,\r\n    background-color 80ms linear,\r\n    color 80ms linear;\r\n}\r\n\r\n.hl-selector__item svg {\r\n  width: 100%;\r\n  height: 100%;\r\n  max-width: 96px;\r\n  display: block;\r\n}\r\n\r\n.hl-selector__item.is-highlighted {\r\n  color: var(--hl-amber-strong);\r\n  opacity: 1;\r\n  background: rgba(220, 185, 0, 0.08);\r\n  outline: 1px solid var(--hl-amber);\r\n  filter: drop-shadow(var(--hl-glow));\r\n}\r\n\r\n.hl-selector__item.is-disabled {\r\n  color: var(--hl-red);\r\n  opacity: 0.62;\r\n}\r\n\r\n.hl-selector__item.is-disabled.is-highlighted {\r\n  background: rgb(255 62 39 / 0.08);\r\n  outline-color: var(--hl-red);\r\n  filter: drop-shadow(0 0 6px rgb(255 62 39 / 0.45));\r\n}\r\n\r\n.hl-selector__name {\r\n  margin-top: 2px;\r\n  font-size: 14px;\r\n  letter-spacing: 0.22em;\r\n  color: var(--hl-amber);\r\n  text-transform: uppercase;\r\n  text-shadow: var(--hl-glow-soft);\r\n  text-align: center;\r\n}\r\n\r\n.hl-selector__name.is-disabled {\r\n  color: var(--hl-red);\r\n  text-shadow: 0 0 6px rgb(255 62 39 / 0.45);\r\n}\r\n\r\n/* ============================================================\r\n * Crosshair (center)\r\n * ============================================================ */\r\n\r\n.hl-crosshair {\r\n  position: absolute;\r\n  left: 50%;\r\n  top: 50%;\r\n  width: 28px;\r\n  height: 28px;\r\n  transform: translate(-50%, -50%);\r\n}\r\n\r\n.hl-crosshair__seg {\r\n  position: absolute;\r\n  display: block;\r\n  background: var(--hl-amber);\r\n  box-shadow: var(--hl-glow);\r\n}\r\n\r\n.hl-crosshair__seg--n,\r\n.hl-crosshair__seg--s {\r\n  left: 50%;\r\n  width: 2px;\r\n  height: 8px;\r\n  transform: translateX(-50%);\r\n}\r\n\r\n.hl-crosshair__seg--n {\r\n  top: 0;\r\n}\r\n\r\n.hl-crosshair__seg--s {\r\n  bottom: 0;\r\n}\r\n\r\n.hl-crosshair__seg--w,\r\n.hl-crosshair__seg--e {\r\n  top: 50%;\r\n  width: 8px;\r\n  height: 2px;\r\n  transform: translateY(-50%);\r\n}\r\n\r\n.hl-crosshair__seg--w {\r\n  left: 0;\r\n}\r\n\r\n.hl-crosshair__seg--e {\r\n  right: 0;\r\n}\r\n\r\n.hl-crosshair.is-firing {\r\n  transform: translate(-50%, -50%) scale(1.18);\r\n}\r\n\r\n.hl-crosshair.is-hit::after {\r\n  position: absolute;\r\n  inset: 8px;\r\n  content: \"\";\r\n  border: 1px solid var(--hl-red);\r\n  transform: rotate(45deg);\r\n  box-shadow: 0 0 8px rgb(255 62 39 / 0.7);\r\n}\r\n\r\n.hl-crosshair__portals {\r\n  position: absolute;\r\n  left: 50%;\r\n  top: calc(100% + 8px);\r\n  display: none;\r\n  gap: 6px;\r\n  transform: translateX(-50%);\r\n}\r\n\r\n.hl-crosshair__portals.is-visible {\r\n  display: flex;\r\n}\r\n\r\n.hl-crosshair__portal-dot {\r\n  width: 6px;\r\n  height: 6px;\r\n  border-radius: 50%;\r\n  opacity: 0.35;\r\n}\r\n\r\n.hl-crosshair__portal-dot--a {\r\n  border: 1px solid #3fa7ff;\r\n}\r\n\r\n.hl-crosshair__portal-dot--b {\r\n  border: 1px solid #ff9a3f;\r\n}\r\n\r\n.hl-crosshair__portal-dot--a.is-placed {\r\n  background: #3fa7ff;\r\n  box-shadow: 0 0 6px rgb(63 167 255 / 0.8);\r\n  opacity: 1;\r\n}\r\n\r\n.hl-crosshair__portal-dot--b.is-placed {\r\n  background: #ff9a3f;\r\n  box-shadow: 0 0 6px rgb(255 154 63 / 0.8);\r\n  opacity: 1;\r\n}\r\n\r\n/* ============================================================\r\n * Interaction prompt (centro inferior)\r\n * ============================================================ */\r\n\r\n.hev-interaction {\r\n  position: absolute;\r\n  left: 50%;\r\n  top: calc(50% + 48px);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  transform: translate(-50%, 8px);\r\n  opacity: 0;\r\n  transition:\r\n    opacity 150ms ease,\r\n    transform 150ms ease;\r\n  font-family: inherit;\r\n}\r\n\r\n.hev-interaction.is-visible {\r\n  transform: translate(-50%, 0);\r\n  opacity: 1;\r\n}\r\n\r\n.hev-interaction__key {\r\n  min-width: 26px;\r\n  padding: 3px 7px;\r\n  border: 1px solid var(--hl-amber);\r\n  color: var(--hl-amber);\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.1em;\r\n  text-align: center;\r\n  box-shadow: var(--hl-glow-soft);\r\n}\r\n\r\n.hev-interaction__label {\r\n  padding: 4px 10px;\r\n  color: var(--hl-amber);\r\n  font-size: 13px;\r\n  letter-spacing: 0.16em;\r\n  text-transform: uppercase;\r\n  text-shadow: var(--hl-glow-soft);\r\n}\r\n\r\n/* ============================================================\r\n * Squad del jugador (bottom-left, encima de los vitales)\r\n * ============================================================ */\r\n\r\n.hev-squad {\r\n  position: absolute;\r\n  left: 32px;\r\n  bottom: 128px;\r\n  padding: 4px 8px;\r\n  border-left: 2px solid var(--hl-amber);\r\n  color: var(--hl-amber);\r\n  font-size: 12px;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.hev-squad.is-hidden {\r\n  display: none;\r\n}\r\n\r\n/* ============================================================\r\n * Notification feed (bottom-right, encima del ammo)\r\n * ============================================================ */\r\n\r\n.hev-feed {\r\n  position: absolute;\r\n  right: 32px;\r\n  bottom: 130px;\r\n  display: grid;\r\n  justify-items: end;\r\n  gap: 4px;\r\n  width: min(340px, calc(100% - 40px));\r\n  font-family: inherit;\r\n}\r\n\r\n.hev-feed__item {\r\n  padding: 4px 8px;\r\n  border-right: 2px solid var(--hl-amber);\r\n  color: var(--hl-amber);\r\n  font-size: 12px;\r\n  letter-spacing: 0.12em;\r\n  text-transform: uppercase;\r\n  transition:\r\n    opacity 260ms ease,\r\n    transform 260ms ease;\r\n}\r\n\r\n.hev-feed__item--pickup {\r\n  border-color: var(--hl-amber-strong);\r\n}\r\n\r\n.hev-feed__item.is-expired {\r\n  transform: translateX(10px);\r\n  opacity: 0;\r\n}\r\n\r\n/* ============================================================\r\n * Anuncio de peligro ambiental (costado izquierdo) — estilo H.E.V.\r\n * ============================================================ */\r\n\r\n.hev-hazard {\r\n  --hazard-color: var(--hl-amber);\r\n  position: absolute;\r\n  left: 35px;\r\n  top: 44%;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 9px 16px 9px 13px;\r\n  border-left: 3px solid var(--hazard-color);\r\n  background: linear-gradient(\r\n    90deg,\r\n    rgb(0 0 0 / 0.5),\r\n    rgb(0 0 0 / 0.12) 70%,\r\n    transparent\r\n  );\r\n  opacity: 0;\r\n  transform: translate(-14px, -50%);\r\n  pointer-events: none;\r\n  transition:\r\n    opacity 180ms ease,\r\n    transform 180ms ease;\r\n}\r\n\r\n.hev-hazard.is-active {\r\n  opacity: 1;\r\n  transform: translate(0, -50%);\r\n}\r\n\r\n.hev-hazard__icon {\r\n  width: 30px;\r\n  height: 30px;\r\n  flex: none;\r\n  color: var(--hazard-color);\r\n  filter: drop-shadow(0 0 6px var(--hazard-color));\r\n}\r\n\r\n/* El icono titila como una luz de advertencia mientras el anuncio está activo. */\r\n.hev-hazard.is-active .hev-hazard__icon {\r\n  animation: hev-hazard-blink 0.85s steps(1, end) infinite;\r\n}\r\n\r\n.hev-hazard__icon svg {\r\n  width: 100%;\r\n  height: 100%;\r\n  display: block;\r\n}\r\n\r\n.hev-hazard__title {\r\n  font-size: 15px;\r\n  letter-spacing: 0.2em;\r\n  line-height: 1.15;\r\n  color: var(--hazard-color);\r\n  text-shadow: 0 0 6px var(--hazard-color);\r\n}\r\n\r\n.hev-hazard__detail {\r\n  font-size: 12px;\r\n  letter-spacing: 0.14em;\r\n  color: var(--hl-amber-dim);\r\n}\r\n\r\n@keyframes hev-hazard-blink {\r\n  0%,\r\n  55% {\r\n    opacity: 1;\r\n  }\r\n  56%,\r\n  100% {\r\n    opacity: 0.32;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .hev-hazard.is-active .hev-hazard__icon {\r\n    animation: none;\r\n  }\r\n}\r\n\r\n/* ============================================================\r\n * Objective panel (arriba-centro) + brújula\r\n * ============================================================ */\r\n\r\n.hev-objective {\r\n  position: absolute;\r\n  left: 50%;\r\n  top: 28px;\r\n  transform: translate(-50%, -8px);\r\n  display: grid;\r\n  justify-items: center;\r\n  gap: 2px;\r\n  max-width: min(560px, calc(100% - 80px));\r\n  padding: 8px 18px;\r\n  border-top: 1px solid var(--hl-amber-faint);\r\n  border-bottom: 1px solid var(--hl-amber-faint);\r\n  background: linear-gradient(rgba(8, 12, 16, 0.55), rgba(8, 12, 16, 0.25));\r\n  opacity: 0;\r\n  transition:\r\n    opacity 200ms ease,\r\n    transform 200ms ease;\r\n}\r\n\r\n.hev-objective.is-visible {\r\n  opacity: 1;\r\n  transform: translate(-50%, 0);\r\n}\r\n\r\n.hev-objective__label {\r\n  font-size: 10px;\r\n  letter-spacing: 0.32em;\r\n  text-transform: uppercase;\r\n  color: var(--hl-amber-dim);\r\n}\r\n\r\n.hev-objective__text {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  letter-spacing: 0.12em;\r\n  text-align: center;\r\n  text-shadow: var(--hl-glow-soft);\r\n}\r\n\r\n.hev-objective.is-completed .hev-objective__text {\r\n  text-decoration: line-through;\r\n  color: var(--hl-amber-dim);\r\n}\r\n\r\n.hev-objective__marker {\r\n  position: absolute;\r\n  left: 0;\r\n  top: 0;\r\n  width: 14px;\r\n  height: 14px;\r\n  transform: translate(-50%, -50%) rotate(45deg);\r\n  border: 1.5px solid var(--hl-amber);\r\n  box-shadow: var(--hl-glow);\r\n  opacity: 0;\